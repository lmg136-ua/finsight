# FinSight Environment Configuration

# Select LLM Provider: 'groq', 'google', or 'openai'
DEFAULT_LLM_PROVIDER=groq

# Groq (Free Tier API - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (Free Tier API - https://aistudio.google.com)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.0-flash

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Vector DB & Embeddings Configuration
CHROMA_DB_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
